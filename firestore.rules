rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default policy
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "anirudrapaul31@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema validations
    function isValidUser(data) {
      return data.uid is string &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.role is string && (data.role == "viewer" || data.role == "admin");
    }

    function isValidBooking(data) {
      return data.id is string &&
             data.showId is string &&
             data.showTitle is string && data.showTitle.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.ticketsCount is int && data.ticketsCount >= 1 && data.ticketsCount <= 10 &&
             data.status is string &&
             data.uid is string;
    }

    function isValidShow(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 250 &&
             data.venue is string && data.venue.size() <= 250 &&
             data.date is string && data.date.size() <= 50 &&
             data.time is string && data.time.size() <= 50 &&
             data.price is string && data.price.size() <= 50 &&
             data.status is string && (data.status == "upcoming" || data.status == "soldout" || data.status == "completed");
    }

    function isValidGalleryItem(data) {
      return data.id is string &&
             data.type is string && (data.type == "photo" || data.type == "video") &&
             data.url is string && data.url.size() <= 1000 &&
             data.title is string && data.title.size() <= 250 &&
             data.category is string && (data.category == "live" || data.category == "bts" || data.category == "promo" || data.category == "quote") &&
             data.likes is int && data.likes >= 0 &&
             data.comments is int && data.comments >= 0;
    }

    function isValidComment(data) {
      return data.id is string &&
             data.photoId is string &&
             data.user is string && data.user.size() <= 100 &&
             data.text is string && data.text.size() <= 2000 &&
             data.date is string;
    }

    function isValidLead(data) {
      return data.id is string &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() <= 5000 &&
             data.sentAt is string;
    }

    function isValidSetting(data) {
      return data.id is string && data.data is map;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Admin lookup helper collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.token.email == "anirudrapaul31@gmail.com" || isAdmin());
    }

    // Bookings collection rules
    match /bookings/{bookingId} {
      allow get: if (existing().uid == "guest") || (isSignedIn() && (existing().uid == request.auth.uid || isAdmin()));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if (
        (incoming().uid == "guest" && isValidBooking(incoming())) ||
        (isSignedIn() && incoming().uid == request.auth.uid && isValidBooking(incoming()))
      );
      allow update, delete: if isAdmin() || (isSignedIn() && (existing().uid == request.auth.uid || isAdmin()));
    }

    // Shows/Events collection rules
    match /shows/{showId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if (isAdmin() && isValidShow(incoming())) || (
        // Let user update tickets status if required, but with narrow validations if needed
        isAdmin()
      );
    }

    // Gallery item collection rules (supports likes increment)
    match /gallery/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if (isAdmin() && isValidGalleryItem(incoming())) || (
        // Allow public to increment likes only
        incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
        incoming().likes == existing().likes + 1
      );
    }

    // Gallery reactions/comments matching
    match /gallery_comments/{commentId} {
      allow read: if true;
      allow create: if isValidComment(incoming());
      allow delete: if isAdmin();
    }

    // Contact form leads collection
    match /leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Generic home page settings overrides
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSetting(incoming());
    }
  }
}
